{
  "name": "whiteframe-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts --dev\" \"vite --host 127.0.0.1 --strictPort\"",
    "build": "npm run check:structure && tsc --noEmit && vite build",
    "check:structure": "node scripts/check-structure.mjs",
    "format": "prettier --write src shared server tests scripts *.ts *.json *.html",
    "format:check": "prettier --check src shared server tests scripts *.ts *.json *.html",
    "start": "tsx server/index.ts",
    "mcp": "tsx server/stdio.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:render": "node scripts/render-smoke.mjs",
    "test:production": "playwright test --config playwright.production.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "@gltf-transform/core": "^4.5.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "dequal": "^2.0.3",
    "express": "^5.1.0",
    "fountain-js": "^1.2.4",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0",
    "three-bvh-csg": "^0.0.18",
    "three-subdivide": "^1.1.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
